# Plantilla de configuracion. Copiar a .env (excluido por .gitignore).
#   cp .env.example .env
# Solo documenta variables; NO contiene secretos reales.

# PIPELINE_DATA_DIR=/ruta/absoluta/a/data   # default: <repo>/data
